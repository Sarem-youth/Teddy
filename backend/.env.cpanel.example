# ══════════════════════════════════════════════════════════════════
#  TEDDY GENERAL TRADING — PRODUCTION ENVIRONMENT TEMPLATE (cPanel)
#  Copy to .env, fill in every ★ value, then run:
#    php artisan key:generate && php artisan migrate --seed --force
# ══════════════════════════════════════════════════════════════════

APP_NAME="Teddy General Trading"
APP_ENV=production
# APP_KEY is filled automatically by `php artisan key:generate` or the
# one-shot installer (public/setup.php). Leave the line exactly as-is.
APP_KEY=
APP_DEBUG=false                # NEVER true in production
APP_URL=https://yourdomain.com # ★ your real https:// domain (used for emails & sitemap)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12               # NFR-4.2.2 bcrypt cost factor

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── MySQL database created in cPanel » MySQL® Databases ──────────
# ★ Fill in all three values below.
# ⚠ IMPORTANT: wrap the password in 'single quotes' if it contains
#   special characters like # $ " or spaces — otherwise it will be
#   silently truncated and MySQL will reject the connection!
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_teddy
DB_USERNAME=cpaneluser_teddy
DB_PASSWORD=''

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync          # shared hosting: run jobs inline
CACHE_STORE=database

# ── SMTP for contact-form routing + password resets (REQ-3.5.2) ──
# Use the email account you create in cPanel » Email Accounts.
# ★ Fill in host, username, password and from-address.
#   Quote the password if it has special characters: MAIL_PASSWORD='p@ss#123'
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=''
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
